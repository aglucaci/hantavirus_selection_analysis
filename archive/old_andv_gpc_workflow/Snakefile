configfile: "config/config.yaml"

from snakemake.shell import shell

shell.executable("bash")

PROTEIN_ALIGNMENT = config["inputs"]["protein_alignment"]
NUCLEOTIDE_FASTA = config["inputs"]["nucleotide_fasta"]
METADATA = config["inputs"]["metadata"]

REFERENCE_METADATA_ID = config["reference"]["metadata_id"]
REFERENCE_HYPHY_ID = config["reference"]["hyphy_id"]
HOST_FILTER = config.get("host_filter", {})
RECOVERED_RAW_ALL = "results/GPC_CDS.recovered.raw.all_hosts.fasta"
RECOVERED_RAW_ALL_QC = "results/GPC_CDS.recovered.raw.qc.tsv"
RECOVERED_RAW_FILTERED = "results/GPC_CDS.recovered.raw.fasta"
RECOVERED_RAW_FILTER_QC = "results/GPC_CDS.recovered.raw.host_filter.qc.tsv"

GLOBAL_PREFIX = "ANDV_GPC_global"
RELAX_PREFIX = "ANDV_GPC_human_vs_reservoir_RELAX"
TREE_PREFIX = "GPC_CDS.mafft_codon_aligned.deduplicated"

HYPHY_ANALYSES = {
    "FEL": "FEL",
    "MEME": "MEME",
    "BUSTED": "BUSTED",
    "aBSREL": "aBSREL",
}


def hyphy_executable():
    configured = config["hyphy"].get("executable", "")
    return configured


def shell_single_quote(value):
    return "'" + str(value).replace("'", "'\"'\"'") + "'"


def hyphy_executable_shell(configured):
    configured = shell_single_quote(configured)
    return rf'''
hyphy_executable={configured}
if [[ -z "$hyphy_executable" ]]; then
  if command -v hyphy-avx >/dev/null 2>&1; then
    hyphy_executable="$(command -v hyphy-avx)"
  elif [[ -x /usr/lib/hyphy/bin/hyphy-avx ]]; then
    hyphy_executable="/usr/lib/hyphy/bin/hyphy-avx"
  elif command -v hyphy >/dev/null 2>&1; then
    hyphy_executable="$(command -v hyphy)"
  else
    echo "ERROR: HyPhy executable not found."
    exit 1
  fi
fi
'''


def hyphy_batch_shell(analysis):
    return rf'''
batch_file=""
for candidate in \
  "/usr/share/hyphy/TemplateBatchFiles/SelectionAnalyses/{analysis}.bf" \
  "/usr/lib/hyphy/TemplateBatchFiles/SelectionAnalyses/{analysis}.bf" \
  "/usr/local/share/hyphy/TemplateBatchFiles/SelectionAnalyses/{analysis}.bf"
do
  if [[ -s "$candidate" ]]; then
    batch_file="$candidate"
    break
  fi
done
if [[ -z "$batch_file" ]]; then
  batch_file="$(find /usr/share/hyphy /usr/lib/hyphy /usr/local/share/hyphy -path "*/SelectionAnalyses/{analysis}.bf" -print -quit 2>/dev/null || true)"
fi
if [[ -z "$batch_file" ]]; then
  echo "ERROR: could not find HyPhy {analysis}.bf"
  exit 1
fi
'''


rule all:
    input:
        "results/dashboard/overview_metrics.json",
        "results/dashboard/ANDV_GPC_selection_annotated_sites.tsv",
        "results/hyphy_host_relax/ANDV_GPC_human_vs_reservoir_RELAX.json",
        "data/reference/ANDV_GPC_reference_annotation.tsv",


rule recover_raw_cds:
    input:
        protein=PROTEIN_ALIGNMENT,
        nucleotide=NUCLEOTIDE_FASTA,
        script="scripts/recover_raw_cds_from_aligned_protein.py",
    output:
        cds=RECOVERED_RAW_ALL,
        qc=RECOVERED_RAW_ALL_QC,
    params:
        min_identity=config["recovery"]["min_identity"],
        missing_as=config["recovery"]["missing_as"],
    log:
        "results/logs/recover_raw_cds.log",
    shell:
        r"""
        mkdir -p results results/logs
        python {input.script} \
          -p {input.protein} \
          -n {input.nucleotide} \
          -o {output.cds} \
          --qc {output.qc} \
          --min-identity {params.min_identity} \
          --missing-as {params.missing_as} \
          --verbose > {log} 2>&1
        """


rule filter_recovered_cds_known_host:
    input:
        cds=RECOVERED_RAW_ALL,
        metadata=METADATA,
        script="scripts/filter_fasta_by_metadata_host.py",
    output:
        cds=RECOVERED_RAW_FILTERED,
        qc=RECOVERED_RAW_FILTER_QC,
    params:
        id_column=HOST_FILTER.get("metadata_id_column", "accessionVersion"),
        host_column=HOST_FILTER.get("host_column", "hostNameScientific"),
        keep_id=REFERENCE_METADATA_ID if HOST_FILTER.get("keep_reference", True) else "",
    log:
        "results/logs/filter_recovered_cds_known_host.log",
    shell:
        r"""
        mkdir -p results results/logs
        keep_id_arg=""
        if [[ -n "{params.keep_id}" ]]; then
          keep_id_arg="--keep-id {params.keep_id}"
        fi
        python {input.script} \
          -i {input.cds} \
          -o {output.cds} \
          --metadata {input.metadata} \
          --qc {output.qc} \
          --id-column {params.id_column} \
          --host-column {params.host_column} \
          $keep_id_arg > {log} 2>&1
        """


