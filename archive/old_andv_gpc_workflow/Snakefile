        cds_fasta="data/reference/NC_003467.2_GPC_CDS.no_stop.fasta",
        protein_fasta="data/reference/NC_003467.2_GPC_protein.no_stop.fasta",
    params:
        ref_id=REFERENCE_METADATA_ID,
        outdir="data/reference",
    log:
        "results/logs/build_reference_annotation.log",
    shell:
        r"""
        mkdir -p data/reference results/logs
        python {input.script} \
          --m-fasta {input.nucleotide} \
          --cds-fasta {input.cds} \
          --ref-id {params.ref_id} \
          --outdir {params.outdir} \
          --verbose > {log} 2>&1
        """


rule label_relax_host_groups:
    input:
        tree=f"results/hyphy_global_selection/{GLOBAL_PREFIX}.hyphy_ready.treefile",
        metadata=METADATA,
        duplicate_map="results/GPC_CDS.mafft_codon_aligned.duplicates.tsv",
        script="scripts/label_tree_for_relax_host_groups.py",
    output:
        tree=f"results/hyphy_host_relax/{RELAX_PREFIX}.treefile",
        qc=f"results/hyphy_host_relax/{RELAX_PREFIX}.qc.tsv",
    params:
        test_host=config["relax"]["test_host"],
        test_label=config["relax"]["test_label"],
        reference_label=config["relax"]["reference_label"],
    log:
        "results/logs/label_relax_host_groups.log",
    shell:
        r"""
        mkdir -p results/hyphy_host_relax results/logs
        python {input.script} \
          --tree {input.tree} \
          --metadata {input.metadata} \
          --output {output.tree} \
          --qc {output.qc} \
          --test-host "{params.test_host}" \
          --test-label "{params.test_label}" \
          --reference-label "{params.reference_label}" \
          --duplicate-map {input.duplicate_map} \
          --verbose > {log} 2>&1
        """


rule hyphy_relax:
    input:
        alignment=f"results/hyphy_global_selection/{GLOBAL_PREFIX}.hyphy_ready.fasta",
        tree=f"results/hyphy_host_relax/{RELAX_PREFIX}.treefile",
    output:
        f"results/hyphy_host_relax/{RELAX_PREFIX}.json",
    params:
        executable=hyphy_executable(),
        executable_script=hyphy_executable_shell(hyphy_executable()),
        test_label=config["relax"]["test_label"],
        reference_label=config["relax"]["reference_label"],
        batch_script=hyphy_batch_shell("RELAX"),
    log:
        "results/logs/hyphy_relax.log",
    shell:
        r"""
        mkdir -p results/hyphy_host_relax results/logs
        {params.executable_script}
        {params.batch_script}
        "$hyphy_executable" "$batch_file" \
          --alignment {input.alignment} \
          --tree {input.tree} \
          --test {params.test_label} \
          --reference {params.reference_label} \
          --output {output} > {log} 2>&1
        """


rule dashboard_data:
    input:
        fel="results/hyphy_global_selection/ANDV_GPC_global_FEL.json",
        meme="results/hyphy_global_selection/ANDV_GPC_global_MEME.json",
        busted="results/hyphy_global_selection/ANDV_GPC_global_BUSTED.json",
        absrel="results/hyphy_global_selection/ANDV_GPC_global_aBSREL.json",
        relax=f"results/hyphy_host_relax/{RELAX_PREFIX}.json",
        annotation="data/reference/ANDV_GPC_reference_annotation.tsv",
        raw_m_fasta=NUCLEOTIDE_FASTA,
        metadata=METADATA,
        script="scripts/build_dashboard_data.py",
    output:
        overview="results/dashboard/overview_metrics.json",
        selected_sites="results/dashboard/ANDV_GPC_selection_annotated_sites.tsv",
    params:
        outdir="results/dashboard",
        fel_q=config["dashboard"]["fel_q"],
        meme_q=config["dashboard"]["meme_q"],
        absrel_p=config["dashboard"]["absrel_p"],
    log:
        "results/logs/dashboard_data.log",
    shell:
        r"""
        mkdir -p results/dashboard results/logs
        python {input.script} \
          --outdir {params.outdir} \
          --raw-m-fasta {input.raw_m_fasta} \
          --metadata {input.metadata} \
          --fel-q {params.fel_q} \
          --meme-q {params.meme_q} \
          --absrel-p {params.absrel_p} > {log} 2>&1
        """
