          --keep-id {params.reference_id} \
          --verbose > {log} 2>&1
        """


rule iqtree2_tree:
    input:
        alignment="results/GPC_CDS.mafft_codon_aligned.deduplicated.fasta",
    output:
        tree="results/iqtree2/GPC_CDS.mafft_codon_aligned.deduplicated.treefile",
        report="results/iqtree2/GPC_CDS.mafft_codon_aligned.deduplicated.iqtree",
        log_file="results/iqtree2/GPC_CDS.mafft_codon_aligned.deduplicated.log",
    params:
        prefix="results/iqtree2/" + TREE_PREFIX,
        model=config["iqtree"]["model"],
        bootstraps=config["iqtree"]["bootstraps"],
        alrt=config["iqtree"]["alrt"],
        threads=config["iqtree"]["threads"],
        extra_args=config["iqtree"].get("extra_args", ""),
    log:
        "results/logs/iqtree2_tree.log",
    shell:
        r"""
        mkdir -p results/iqtree2 results/logs
        iqtree2 \
          -s {input.alignment} \
          -m {params.model} \
          -B {params.bootstraps} \
          -alrt {params.alrt} \
          -T {params.threads} \
          --prefix {params.prefix} \
          -redo \
          {params.extra_args} > {log} 2>&1
        """


rule clean_hyphy_inputs:
    input:
        alignment="results/GPC_CDS.mafft_codon_aligned.deduplicated.fasta",
        tree="results/iqtree2/GPC_CDS.mafft_codon_aligned.deduplicated.treefile",
        script="scripts/filter_hyphy_codon_inputs.py",
    output:
        alignment=f"results/hyphy_global_selection/{GLOBAL_PREFIX}.hyphy_ready.fasta",
        tree=f"results/hyphy_global_selection/{GLOBAL_PREFIX}.hyphy_ready.treefile",
        qc=f"results/hyphy_global_selection/{GLOBAL_PREFIX}.hyphy_ready.qc.tsv",
    params:
        reference_id=REFERENCE_HYPHY_ID,
    log:
        "results/logs/clean_hyphy_inputs.log",
    shell:
        r"""
        mkdir -p results/hyphy_global_selection results/logs
        python {input.script} \
          --alignment {input.alignment} \
          --tree {input.tree} \
          --out-alignment {output.alignment} \
          --out-tree {output.tree} \
          --qc {output.qc} \
          --require-id {params.reference_id} \
          --verbose > {log} 2>&1
        """


rule hyphy_global_selection:
    input:
        alignment=f"results/hyphy_global_selection/{GLOBAL_PREFIX}.hyphy_ready.fasta",
        tree=f"results/hyphy_global_selection/{GLOBAL_PREFIX}.hyphy_ready.treefile",
    output:
        "results/hyphy_global_selection/ANDV_GPC_global_{analysis}.json",
    params:
        executable=hyphy_executable(),
        executable_script=hyphy_executable_shell(hyphy_executable()),
        batch=lambda wildcards: HYPHY_ANALYSES[wildcards.analysis],
        batch_script=lambda wildcards: hyphy_batch_shell(HYPHY_ANALYSES[wildcards.analysis]),
    log:
        "results/logs/hyphy_global_{analysis}.log",
    wildcard_constraints:
        analysis="FEL|MEME|BUSTED|aBSREL"
    shell:
        r"""
        mkdir -p results/hyphy_global_selection results/logs
        {params.executable_script}
        {params.batch_script}
        "$hyphy_executable" "$batch_file" \
          --alignment {input.alignment} \
          --tree {input.tree} \
          --output {output} > {log} 2>&1
        """


