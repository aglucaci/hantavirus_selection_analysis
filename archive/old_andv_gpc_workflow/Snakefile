rule mafft_protein_alignment:
    input:
        protein="results/GPC_protein.from_recovered_CDS.fasta",
    output:
        alignment="results/GPC_protein.from_recovered_CDS.mafft.aligned.fasta",
    threads:
        config["mafft"]["threads"]
    log:
        "results/logs/mafft_protein_alignment.log",
    shell:
        r"""
        mkdir -p results results/logs
        mafft --auto --thread {threads} {input.protein} > {output.alignment} 2> {log}
        """


