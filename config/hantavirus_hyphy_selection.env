# Configuration for scripts/run_hantavirus_hyphy_selection.sh.
#
# Values use the `: "${VAR:=value}"` form so command-line environment variables
# still take precedence. Example:
#
#   RELAX_STARTING_POINTS=25 bash scripts/run_hantavirus_hyphy_selection.sh

: "${SAMPLE_SHEET:=andv_trees_sample_sheet.tsv}"
: "${FORCE:=0}"
: "${VERBOSE:=1}"
: "${ONLY:=all}"

# RELAX optimization can be sensitive to local maxima. Increase this when
# rerunning RELAX diagnostics, e.g. 10 or 25.
: "${RELAX_STARTING_POINTS:=1}"

# MSS is slower and off by default.
: "${RUN_MSS:=0}"
: "${MSS_CLASSES:=}"

# Branch labels used in prepared Newick trees.
: "${SELECTION_BRANCHES:=Foreground}"
: "${FEL_BRANCHES:=$SELECTION_BRANCHES}"
: "${MEME_BRANCHES:=$SELECTION_BRANCHES}"
: "${ABSREL_BRANCHES:=$SELECTION_BRANCHES}"

# Ancestral sequence export from MEME_imputed JSONs.
: "${EXTRACT_ANCESTRAL:=1}"
: "${ANCESTRAL_METHODS:=MEME_imputed}"
